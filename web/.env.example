# =============================================================================
# TITI'S STORE & CONSULTOR — VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env.local (no desenvolvimento) e configure na Vercel (em produção).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS & AUTH)
# Onde obter: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://dusavcbgomdosfjodups.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YH8NQJfUpbnItrGmVYFtJQ_DDXgZDPh

# CHAVE SECRETA DE SERVIÇO (OBRIGATÓRIA PARA CHECKOUT, WEBHOOKS E DISPAROS):
# Onde obter: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta_aqui

# -----------------------------------------------------------------------------
# 2. MERCADO PAGO (CHECKOUT TRANSPARENTE, PIX & CARTÃO)
# Onde obter: https://www.mercadopago.com.br/developers/panel/app
# -----------------------------------------------------------------------------
# Token de Acesso Privado (Use 'APP_USR-...' para produção ou 'TEST-...' para testes)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu_access_token_aqui

# Chave Pública (Necessária para validação e tokenização segura)
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua_public_key_aqui

# Segredo de Webhook (Recomendado para validar autenticidade dos webhooks do MP)
# Onde obter: Painel do Desenvolvedor MP -> Webhooks -> Configurar URL (https://seudominio.com/api/webhooks/mercadopago)
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# -----------------------------------------------------------------------------
# 3. MELHOR ENVIO (CÁLCULO DE FRETE & ETIQUETAS DOS CORREIOS / JADLOG)
# Onde obter: https://melhorenvio.com.br/painel/gerenciar/tokens
# -----------------------------------------------------------------------------
# Token de Acesso à API do Melhor Envio
MELHORENVIO_TOKEN=seu_token_melhor_envio_aqui

# CEP de Origem (De onde as roupas da Titi's Store saem para entrega)
MELHORENVIO_ORIGIN_CEP=30130000

# Ambiente: 'false' para produção ou 'true' para testes no sandbox
MELHORENVIO_SANDBOX=false

# -----------------------------------------------------------------------------
# 4. EVOLUTION API (DISPARO DE WHATSAPP PÓS-VENDA)
# Onde obter: Painel da sua instância Evolution API (ex: https://app.evolution-api.com)
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=https://api.suaevolution.com.br
EVOLUTION_API_KEY=sua_chave_global_ou_da_instancia
EVOLUTION_INSTANCE_NAME=titis-store

# -----------------------------------------------------------------------------
# 5. RESEND (DISPARO AUTOMÁTICO DE E-MAILS & NEWSLETTER)
# Onde obter: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_sua_chave_resend_aqui
EMAIL_FROM="Titi's Store <pedidos@titisstore.com.br>"

# -----------------------------------------------------------------------------
# 6. CONFIGURAÇÕES GERAIS E DOMÍNIOS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.titisstore.com.br
NEXT_PUBLIC_CONSULTOR_URL=https://consultor.titisstore.com.br
NEXT_PUBLIC_CONSULTOR_DOMAIN=consultor.titisstore.com.br
NEXT_PUBLIC_CHECKOUT_PROVIDER=mercadopago

# IA CONSULTORIA (OPCIONAL / RECOMENDADO):
GEMINI_API_KEY=sua_chave_gemini_aqui
GROQ_API_KEY=sua_chave_groq_aqui
