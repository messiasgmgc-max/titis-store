# ============================================================
# Titi's Store — variáveis de ambiente
# Copie este arquivo para .env.local (desenvolvimento) e cadastre os mesmos
# nomes na Vercel em Project Settings > Environment Variables (produção).
# ============================================================
#
# REGRA DE OURO: chaves de IA ficam SOMENTE no servidor.
# NUNCA use o prefixo NEXT_PUBLIC_ nelas. Tudo que começa com NEXT_PUBLIC_
# é embutido no JavaScript enviado ao navegador e fica visível para qualquer
# visitante (basta abrir o código-fonte da página).
# Nomes antigos como NEXT_PUBLIC_GEMINI_API_KEY e NEXT_PUBLIC_GROQ_API_KEY NÃO
# são mais lidos: apague-os, gere chaves novas (as antigas ficaram expostas no
# navegador) e cadastre-as como GEMINI_API_KEY e GROQ_API_KEY.

# ------------------------------------------------------------
# Supabase (valores públicos por natureza)
# Painel do Supabase > Project Settings > API.
# A chave publicável/anon pode ir ao navegador: o acesso é controlado pelas
# políticas RLS do banco. NUNCA coloque aqui a service_role key.
# Se ausentes, o app usa o projeto padrão definido em src/lib/supabaseClient.ts.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sua_chave_publicavel

# URL pública do site, usada em metadados e links de compartilhamento (opcional).
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ------------------------------------------------------------
# Google Gemini — leitura de colorimetria por foto, composição de looks,
# provador virtual e cadastro de produtos por foto (admin).
# Gere a chave em https://aistudio.google.com/apikey
# Sem esta chave o site continua funcionando: a leitura por foto passa a ser
# local, os looks vêm do motor local de looks e o provador virtual fica indisponível.
# ------------------------------------------------------------
GEMINI_API_KEY=

# Opcional: modelo(s) preferido(s), separados por vírgula. O servidor tenta
# primeiro os informados e, se estiverem indisponíveis, segue a cadeia padrão:
#   texto/visão: gemini-3.8-flash > gemini-3.7-flash > gemini-2.5-flash
#   imagem:      gemini-3.1-flash-image > gemini-2.5-flash-image
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# ------------------------------------------------------------
# Groq — concierge de estilo (chat) e reserva para a composição de looks.
# Gere a chave em https://console.groq.com/keys
# Sem Groq, o concierge usa o Gemini e, sem nenhuma chave, respostas locais.
# ------------------------------------------------------------
GROQ_API_KEY=

# Opcional: modelo(s) preferido(s), separados por vírgula.
# Cadeia padrão: openai/gpt-oss-120b > openai/gpt-oss-20b
GROQ_MODEL=

# ------------------------------------------------------------
# Planos da consultoria — como a compra é concluída
# ------------------------------------------------------------
# whatsapp (padrão): o cliente fala com o Titi e o acesso é liberado no painel
#   admin (aba Clientes → "Liberar acesso").
# mercadopago: checkout Pix/cartão com liberação automática. Só ative depois de
#   preencher as três variáveis de servidor abaixo e cadastrar o webhook.
# Esta é a ÚNICA variável deste bloco que pode ter NEXT_PUBLIC_ (não é segredo).
NEXT_PUBLIC_CHECKOUT_PROVIDER=whatsapp

# ------------------------------------------------------------
# Mercado Pago — SOMENTE SERVIDOR (nunca use o prefixo NEXT_PUBLIC_)
# Painel: https://www.mercadopago.com.br/developers/panel/app
#   > sua aplicação > Credenciais de produção (ou de teste) > Access Token.
# Tokens que começam com TEST- abrem o checkout em modo sandbox.
# ------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=

# Assinatura secreta do webhook (Suas integrações > Webhooks > Configurar
# notificações > Assinatura secreta). URL: https://SEU-DOMINIO/api/webhooks/mercadopago
# com o evento "Pagamentos". Sem ela TODAS as notificações são recusadas.
MERCADOPAGO_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Supabase service role — SOMENTE SERVIDOR. PERIGO.
# Supabase > Project Settings > API Keys > service_role / secret key.
# Ignora todas as regras de segurança (RLS) do banco: quem tiver esta chave lê e
# altera qualquer dado. NUNCA use NEXT_PUBLIC_, nunca importe em componentes de
# cliente e nunca compartilhe. Usada apenas pelo checkout e pelo webhook.
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
